{
  "name": "krakow-mld-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Kraków public transport (KMK) plus the Małopolska feeder lines (MLD, Koleje Małopolskie) — GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=8192 pipeline/build.mjs --all --tram 1,3,5,8,9,10,11,13,14,16,17,18,20,21,22,49,50,52,62,69,74,75,76",
    "report": "node pipeline/report-gaps.mjs",
    "serve": "node pipeline/serve.mjs 8156",
    "lines": "node pipeline/lines.mjs",
    "audit": "node --max-old-space-size=6144 pipeline/audit.mjs",
    "schematic": "node --max-old-space-size=4096 pipeline/schematic/build-schematic.mjs"
  }
}
